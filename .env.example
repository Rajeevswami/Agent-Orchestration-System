# ── LLM providers ─────────────────────────────────────────────────────────────
# "openai" | "anthropic" | "scripted" (offline demo / tests, no API keys needed)
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional per-role overrides (fall back to the provider model above)
# SUPERVISOR_MODEL=gpt-4o
# RESEARCHER_MODEL=gpt-4o-mini
# ANALYST_MODEL=gpt-4o
# WRITER_MODEL=gpt-4o

TEMPERATURE=0.2
MAX_TOKENS=2048

# ── Memory ────────────────────────────────────────────────────────────────────
# Postgres in Docker: postgresql+psycopg://agent:agent@localhost:5432/agent_orch
DATABASE_URL=sqlite:///./data/agent_orchestrator.db

# "persistent" (local dir) | "ephemeral" | "http" (Chroma server)
CHROMA_MODE=persistent
CHROMA_PATH=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# "hashing" (fully offline) | "openai"
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_TOP_K=5

# ── Queue ─────────────────────────────────────────────────────────────────────
# "inline" (run in-process; great for dev) | "celery" (Redis + Celery workers)
QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379/0

# ── Orchestration policy ──────────────────────────────────────────────────────
MAX_SUPERVISOR_ITERATIONS=8
MAX_TOOL_STEPS=5
MIN_CONFIDENCE=0.55
ESCALATION_ON_LOW_CONFIDENCE=true
REQUIRE_FINAL_APPROVAL=false

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
